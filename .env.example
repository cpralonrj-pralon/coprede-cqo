# =============================================================================
# COP REDE - CQO (CENTRAL DE QUALIDADE OPERACIONAL)
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme o seu projeto Supabase
# =============================================================================

# Configuração Geral
NODE_ENV=development
PORT=3000

# =============================================================================
# SUPABASE (Frontend & API)
# Obtenha estas credenciais em: https://supabase.com -> Seu Projeto -> Project Settings -> API
# =============================================================================
VITE_SUPABASE_URL=https://seu-projeto-cqo.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.seu-token-anon-publico-do-supabase

# Conexão Direta ao Banco PostgreSQL do Supabase (para migrations / Prisma / Backend)
# Encontrado em: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.seu-projeto:sua_senha_segura@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Autenticação e Segurança (JWT / SSO Corporativo)
JWT_SECRET=cqo_secret_token_cop_rede_governance_2026
JWT_EXPIRES_IN=8h

# Integrações Corporativas & Webhooks de Escalonamento (Teams / E-mail / WhatsApp)
TEAMS_WEBHOOK_ALERTS_URL=https://outlook.office.com/webhook/seu-teams-webhook
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=cqo.notificacoes@coprede.com.br
SMTP_PASS=senha_app_office365
SMTP_FROM="CQO COP Rede" <cqo.notificacoes@coprede.com.br>

# Parâmetros de SLA & Governança (em dias)
SLA_FIRST_TREATMENT_DAYS=5
SLA_EXECUTIVE_ESCALATION_DAYS=10
